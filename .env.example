# NestJS backend API base URL
API_URL=https://api.renturstatus.com/api
# CDN serving product images and avatars (must match images.remotePatterns in next.config.ts)
ASSET_URL=https://rus-assets.fra1.cdn.digitaloceanspaces.com
# Link service that opens products in the mobile app or falls back to the app stores
LINK_URL=https://link.renturstatus.com
# Public URL of this site; payment gateways return buyers to $SITE_URL/marketplace/checkout/complete
SITE_URL=https://renturstatus.com
